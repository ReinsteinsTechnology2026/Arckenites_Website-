/* Paste this into the Apps Script editor bound to your Google Sheet
   (Extensions > Apps Script). See README.md in this folder for the full
   deployment steps, including the one-time authorization this version
   needs (it now sends email and fetches external images). This file is
   not executed by the website itself — it only runs inside Google's
   servers once you deploy it there. */

var EVENT_NAME = 'Arckenites Inauguration Event';
var EVENT_DATE_LINE = 'Sunday, 1 November 2026';
var EVENT_TIME_LINE = '10:00 AM – 12:30 PM';
var EVENT_VENUE_LINE = 'Krishna Kutir, No. 6/24, Ramanathan Street, Mahalingapuram, Nungambakkam, Chennai, Tamil Nadu 600034';

// LOGO_IMAGE_URL is kept only as a record of where the logo asset comes
// from (inauguration/assets/logo-wordmark.png, served from the production
// site). It is NOT fetched live any more — see LOGO_BASE64_PNG below for
// why. QR_SERVICE_URL is still fetched live (it is unique per ticket) and
// remains defensively wrapped in buildTicketPdf_ so a network hiccup
// degrades to a text-only fallback instead of failing ticket generation.
var LOGO_IMAGE_URL = 'https://arckenites.com/assets/logo-wordmark.png';
var QR_SERVICE_URL = 'https://api.qrserver.com/v1/create-qr-code/?size=260x260&ecc=M&data=';

// The deployed Web App's own /exec URL — must match
// window.INAUGURATION_SHEET_ENDPOINT in inauguration/index.html exactly.
// The QR code encodes WEB_APP_URL + '?ticket=' + ticketId so scanning it
// opens a real page (doGet's ticket-verification branch below), not plain
// unopenable text. If this deployment is ever replaced with a new /exec
// URL, update both this constant and index.html together.
var WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbxfP1wbw56HkTq0aF4zUFDSayfi-gX8st_RAD2ORKhx5cPtRdC1IqX54hUqwhs-NOE2/exec';

// Brand palette for the PDF ticket (buildTicketPdf_ only). Solid hex only
// — no rgba()/alpha colors anywhere in the ticket HTML. Apps Script's PDF
// conversion is a limited rendering engine, and alpha-channel colors are
// exactly the kind of CSS feature such engines are prone to mis-parse or
// silently drop; a muted solid tone (BRAND_MUTED) is used everywhere the
// previous design used rgba(255,255,255, <alpha>) for secondary text.
var BRAND_PURPLE = '#4A355E';
var BRAND_PURPLE_DARK = '#352443';
var BRAND_GOLD = '#D4AF37';
var BRAND_MUTED = '#C8BFD2';

// The Arckenites logo, embedded directly rather than fetched live at
// email-send time. Investigated first: LOGO_IMAGE_URL currently does
// serve a valid 615KB PNG (verified: HTTP 200, Content-Type image/png,
// correct PNG file signature) — but the same production host returned a
// Cloudflare error (HTTP 530) for this exact URL at another point during
// this project, so a live fetch cannot be trusted as the PDF's only
// source of branding; Apps Script's outbound requests may also be treated
// differently by Cloudflare than a normal browser's. Embedding removes
// that external dependency entirely, so the logo is now guaranteed to
// render every time, not just when the production site happens to answer.
// This is a resized (480x160, proportional, no distortion), re-exported
// copy of the existing inauguration/assets/logo-wordmark.png asset — not
// a new or different logo. It keeps that file's transparent background,
// which is why its white/orange chrome lettering reads cleanly against
// the royal-purple ticket background below.
var LOGO_BASE64_PNG = '';

// Tickets are sent via Microsoft Graph (not MailApp) so the sender address
// is this mailbox, not whichever Google account authorizes this script.
// Credentials come from Script Properties only — see getGraphAccessToken_.
var GRAPH_SENDER_ADDRESS = 'admin@arckenites.com';

// Column layout. The first 11 (A-K) are the original registration fields —
// their order and meaning are never changed. L-P are new, appended after
// them, never inserted in between (see ensureHeaders_).
var HEADERS = [
  'Timestamp', 'Full Name', 'Mobile Number', 'WhatsApp Number', 'Email', 'Address',
  'Domain', 'Travel Method', 'Preferred Food', 'T-Shirt Size', 'Comments / Feedback',
  'Ticket ID', 'Ticket Status', 'Email Status', 'Email Sent At', 'Email Error',
];
var COL_EMAIL = 5;
var COL_TICKET_ID = 12;
var COL_TICKET_STATUS = 13;
var COL_EMAIL_STATUS = 14;
var COL_EMAIL_SENT_AT = 15;
var COL_EMAIL_ERROR = 16;

/* PERFORMANCE: PDF generation and email delivery are NOT done here
   synchronously any more. Profiling the previous version (see the commit
   history / README) showed every registration paying for four real
   network round trips before the website could even respond: a QR code
   fetch, an HTML-to-PDF conversion (one of the slower Apps Script calls),
   a Microsoft OAuth token exchange, and a Graph sendMail call — easily
   several seconds, all while the registrant's browser just sat waiting.
   doPost now does only the fast, local part (validate, dedupe, assign a
   ticket ID, save the row) and returns immediately. The row is saved with
   Ticket Status/Email Status = 'Pending'; a time-driven trigger calling
   resendFailedTickets() (already built for manual retries — see that
   function) picks up any 'Pending' row within about a minute and does the
   slow PDF+email work there, off the request path entirely. See
   createPendingTicketsTrigger_setup() and README.md for the one-time
   trigger setup this requires. */
function doPost(e) {
  var tStart = Date.now();
  var lock = LockService.getScriptLock();
  lock.waitLock(10000); // serializes concurrent submissions so rows/ticket IDs are never interleaved or duplicated
  try {
    var data = JSON.parse(e.postData.contents);

    var name = String(data.name || '').trim();
    var mobile = String(data.mobile || '').trim();
    var whatsapp = String(data.whatsapp || '').trim();
    var email = String(data.email || '').trim();
    var address = String(data.address || '').trim();
    var domain = String(data.domain || '').trim();
    var travel = String(data.travel || '').trim();
    var food = String(data.food || '').trim();
    var tshirt = String(data.tshirt || '').trim();
    var comments = String(data.comments || '').trim();

    if (!name || !mobile || !whatsapp || !email || !address || !domain || !travel || !food || !tshirt) {
      return jsonResponse_({ status: 'error', message: 'Missing required field' });
    }

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Registrations');
    if (!sheet) {
      sheet = SpreadsheetApp.getActiveSpreadsheet().insertSheet('Registrations');
    }
    ensureHeaders_(sheet);
    var tSheetReady = Date.now();

    // One registration (and therefore one ticket, one email) per email
    // address. This also makes accidental double-clicks and network-retry
    // resubmissions safe: a resubmission of an already-saved email is
    // rejected here, before any ticket or email work ever happens again.
    if (findRowByEmail_(sheet, email) !== -1) {
      return jsonResponse_({
        status: 'duplicate',
        message: 'This email has already been registered for this event.',
      });
    }
    var tDupChecked = Date.now();

    var ticketId = generateUniqueTicketId_(sheet);
    var tTicketId = Date.now();

    // Save the registration with placeholder ticket/email statuses. PDF
    // generation and email delivery happen later, asynchronously — see
    // the function-level comment above. If the trigger never ran for some
    // reason, this row still safely records the registration and ticket
    // ID; nothing is lost, only the email is delayed.
    sheet.appendRow([
      new Date(), name, mobile, whatsapp, email, address, domain, travel, food, tshirt, comments,
      ticketId, 'Pending', 'Pending', '', '',
    ]);
    var tSaved = Date.now();

    console.log('doPost timing (ms): sheetReady=' + (tSheetReady - tStart)
      + ' dupCheck=' + (tDupChecked - tSheetReady)
      + ' ticketId=' + (tTicketId - tDupChecked)
      + ' save=' + (tSaved - tTicketId)
      + ' TOTAL=' + (tSaved - tStart));

    // The website's own success message only ever promises that a ticket
    // "will be sent" — it never claims the email already succeeded, so it
    // stays accurate even though delivery is now deferred to the trigger.
    return jsonResponse_({ status: 'ok', ticketId: ticketId });
  } catch (err) {
    return jsonResponse_({ status: 'error', message: String(err) });
  } finally {
    lock.releaseLock();
  }
}

/* Backfills the 5 new trailing columns onto the header row without ever
   touching or reordering the original 11 columns — safe to run against a
   brand-new empty sheet, or an existing sheet that already has rows from
   before the ticket system existed. */
function ensureHeaders_(sheet) {
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(HEADERS);
    return;
  }
  var existingHeaderCount = sheet.getLastColumn();
  if (existingHeaderCount < HEADERS.length) {
    var newHeaders = HEADERS.slice(existingHeaderCount);
    sheet.getRange(1, existingHeaderCount + 1, 1, newHeaders.length).setValues([newHeaders]);
  }
}

/* Returns the 1-based row index of an existing registration with this
   email (case-insensitive), or -1 if none exists yet. */
function findRowByEmail_(sheet, email) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return -1;
  var normalized = email.toLowerCase();
  var values = sheet.getRange(2, COL_EMAIL, lastRow - 1, 1).getValues();
  for (var i = 0; i < values.length; i++) {
    if (String(values[i][0] || '').trim().toLowerCase() === normalized) {
      return i + 2;
    }
  }
  return -1;
}

/* Used by the QR-scan verification page (doGet) to resolve a ticket ID
   back to its row. Ticket IDs are compared case-insensitively since a
   phone's camera/QR app could plausibly normalize case, though
   generateUniqueTicketId_ always produces uppercase. Returns the full row
   (0-indexed array, same shape as HEADERS) or null if no match — never
   throws, so an invalid/mistyped ticket ID is just "not found", not a
   server error. */
function findRowByTicketId_(sheet, ticketId) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var normalized = String(ticketId || '').trim().toUpperCase();
  if (!normalized) return null;
  var values = sheet.getRange(2, 1, lastRow - 1, HEADERS.length).getValues();
  for (var i = 0; i < values.length; i++) {
    var rowTicketId = String(values[i][COL_TICKET_ID - 1] || '').trim().toUpperCase();
    if (rowTicketId === normalized) return values[i];
  }
  return null;
}

/* A short, URL/QR-friendly ticket ID. Verified unique against every ticket
   ID already in the sheet (not just assumed-unique from randomness alone),
   and generated while still holding doPost's script lock, so two
   concurrent submissions can never be assigned the same ID. */
function generateUniqueTicketId_(sheet) {
  var lastRow = sheet.getLastRow();
  var existing = {};
  if (lastRow > 1) {
    var values = sheet.getRange(2, COL_TICKET_ID, lastRow - 1, 1).getValues();
    for (var i = 0; i < values.length; i++) {
      var v = String(values[i][0] || '').trim();
      if (v) existing[v] = true;
    }
  }
  var ticketId;
  do {
    ticketId = 'ARCK-' + Utilities.getUuid().split('-')[0].substring(0, 6).toUpperCase();
  } while (existing[ticketId]);
  return ticketId;
}

/* Builds the personalised PDF ticket. The QR code is built from the ticket
   ID alone — never the name, email, mobile number or any other personal
   detail — so scanning it can only ever reveal that non-sensitive
   reference, never contact information. Both external image fetches
   (branding logo, QR code) are wrapped so a network hiccup degrades to a
   text-only fallback instead of failing ticket generation outright. */
function buildTicketPdf_(name, ticketId, food) {
  var tPdfStart = Date.now();
  var logoImgTag = '<img src="data:image/png;base64,' + LOGO_BASE64_PNG + '" style="height:52px;width:auto;display:block;margin:0 auto;" alt="Arckenites">';

  // Food-preference-colored QR container. Only the rounded background
  // behind the QR changes — the QR modules themselves stay black (drawn by
  // the external QR service, never recolored here), so contrast against a
  // light pastel background is still extremely high and the code remains
  // reliably scannable. Unrecognized/missing food values fall back to the
  // original neutral white rather than guessing a color.
  var normalizedFood = String(food || '').trim().toLowerCase();
  var qrBgColor = '#ffffff';
  if (normalizedFood === 'veg') {
    qrBgColor = '#CDEFD2'; // light, high-contrast green
  } else if (normalizedFood === 'non-veg' || normalizedFood === 'nonveg' || normalizedFood === 'non veg') {
    qrBgColor = '#F6CFCF'; // light, high-contrast red
  }

  var qrImgTag = '';
  try {
    // The QR encodes a URL to this same Web App's own ticket-verification
    // page (doGet, ?ticket=...) — never the name, email, mobile, address or
    // any other personal detail. Scanning it opens a real page instead of
    // unopenable plain text; the page itself looks up and shows only the
    // ticket ID, name and food preference (see doGet below).
    var qrTargetUrl = WEB_APP_URL + '?ticket=' + encodeURIComponent(ticketId);
    var qrBlob = UrlFetchApp.fetch(QR_SERVICE_URL + encodeURIComponent(qrTargetUrl), { muteHttpExceptions: true }).getBlob();
    if (qrBlob && qrBlob.getBytes().length > 0) {
      var qrBase64 = Utilities.base64Encode(qrBlob.getBytes());
      qrImgTag = '<img src="data:image/png;base64,' + qrBase64 + '" style="width:150px;height:150px;display:block;margin:0 auto;" alt="Ticket QR code">';
    }
  } catch (qrErr) {
    qrImgTag = '';
  }
  var tQrDone = Date.now();

  var safeName = escapeHtml_(name);
  var safeTicketId = escapeHtml_(ticketId);

  // Royal-purple background, white wording, gold accents/dividers.
  //
  // WHY THE PREVIOUS VERSION RENDERED WHITE: the HTML string itself always
  // had the correct background-color declarations (verified directly —
  // see the test suite). The cause is a well-known browser/print-engine
  // default: "print-color-adjust: economy", which silently drops
  // background colors and background images when rendering for print, to
  // save ink. Apps Script's HtmlOutput.getAs('application/pdf') conversion
  // goes through that same print rendering path, so a background-color
  // that renders fine in a normal browser tab can still disappear in the
  // exported PDF unless the page explicitly opts out of that economy mode
  // with "print-color-adjust: exact" (and its -webkit- prefixed form, for
  // the Chromium-based engine Apps Script's conversion is built on). This
  // is applied three ways below for redundancy, since there is no way to
  // test Apps Script's exact PDF engine locally: a <style> rule targeting
  // every element, PLUS the same declarations repeated inline on every
  // element that carries a background-color. All rgba()/alpha colors were
  // also replaced with solid hex (see BRAND_MUTED) — alpha-channel colors
  // are exactly the kind of CSS a limited rendering engine is prone to
  // mis-parse or ignore, which plausibly explains the reported grey text.
  var colorAdjustCss = '-webkit-print-color-adjust:exact;print-color-adjust:exact;color-adjust:exact;';
  var html = ''
    + '<html><head><meta charset="utf-8"><style>'
    + 'html,body,*{-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important;color-adjust:exact !important;}'
    + '</style></head>'
    + '<body style="margin:0;padding:0;background:' + BRAND_PURPLE + ';font-family:Helvetica,Arial,sans-serif;' + colorAdjustCss + '">'
    + '<div style="width:600px;margin:0 auto;background:' + BRAND_PURPLE + ';border:1px solid ' + BRAND_GOLD + ';border-radius:16px;overflow:hidden;' + colorAdjustCss + '">'

    + '<div style="padding:34px 40px 22px;text-align:center;background:' + BRAND_PURPLE + ';' + colorAdjustCss + '">'
    + logoImgTag
    + '<div style="height:3px;width:64px;background:' + BRAND_GOLD + ';margin:18px auto;' + colorAdjustCss + '"></div>'
    + '<div style="font-size:21px;font-weight:800;letter-spacing:.5px;color:#ffffff;">ARCKENITES INAUGURATION 2026</div>'
    + '<div style="font-size:11px;font-weight:700;letter-spacing:3px;color:' + BRAND_GOLD + ';margin-top:6px;">OFFICIAL INVITATION PASS</div>'
    + '</div>'

    + '<div style="margin:0 40px 24px;padding:24px 26px;background:' + BRAND_PURPLE_DARK + ';border-left:4px solid ' + BRAND_GOLD + ';border-radius:10px;' + colorAdjustCss + '">'
    + '<div style="font-size:10px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-bottom:6px;">INVITEE</div>'
    + '<div style="font-size:20px;font-weight:800;color:#ffffff;word-wrap:break-word;line-height:1.3;">' + safeName + '</div>'
    + '</div>'

    + '<div style="margin:0 40px 24px;background:' + BRAND_PURPLE + ';' + colorAdjustCss + '">'
    + '<table style="width:100%;border-collapse:collapse;margin-bottom:16px;" cellpadding="0" cellspacing="0">'
    + '<tr>'
    + '<td style="width:50%;padding:0 10px 0 0;vertical-align:top;">'
    + '<div style="font-size:10px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-bottom:6px;">DATE</div>'
    + '<div style="font-size:16px;font-weight:800;color:#ffffff;">' + escapeHtml_(EVENT_DATE_LINE) + '</div>'
    + '</td>'
    + '<td style="width:50%;padding:0 0 0 10px;vertical-align:top;border-left:1px solid ' + BRAND_GOLD + ';">'
    + '<div style="font-size:10px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-bottom:6px;">TIME</div>'
    + '<div style="font-size:16px;font-weight:800;color:#ffffff;">' + escapeHtml_(EVENT_TIME_LINE) + '</div>'
    + '</td>'
    + '</tr>'
    + '</table>'
    + '<div style="padding-top:14px;border-top:1px solid ' + BRAND_GOLD + ';">'
    + '<div style="font-size:10px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-bottom:6px;">VENUE</div>'
    + '<div style="font-size:13.5px;line-height:1.6;color:#ffffff;word-wrap:break-word;">' + escapeHtml_(EVENT_VENUE_LINE) + '</div>'
    + '</div>'
    + '</div>'

    + '<div style="margin:0 40px 28px;padding:24px;background:' + BRAND_PURPLE_DARK + ';border-radius:10px;text-align:center;' + colorAdjustCss + '">'
    + (qrImgTag
      ? '<div style="display:inline-block;padding:14px;background:' + qrBgColor + ';border-radius:10px;' + colorAdjustCss + '">' + qrImgTag + '</div>'
        + '<div style="font-size:11px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-top:14px;">TICKET ID</div>'
        + '<div style="font-size:20px;font-weight:800;letter-spacing:1px;color:' + BRAND_GOLD + ';margin-top:4px;">' + safeTicketId + '</div>'
        + '<div style="font-size:11px;color:' + BRAND_MUTED + ';margin-top:10px;">Present this ticket at the registration desk.</div>'
      : '<div style="font-size:11px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';margin-bottom:4px;">TICKET ID</div>'
        + '<div style="font-size:18px;font-weight:800;color:' + BRAND_GOLD + ';letter-spacing:1px;">' + safeTicketId + '</div>'
        + '<div style="font-size:11px;color:' + BRAND_MUTED + ';margin-top:8px;">Please present this ticket ID at the registration desk.</div>')
    + '</div>'

    + '<div style="margin:0 40px;padding:18px 0 32px;border-top:1px solid ' + BRAND_GOLD + ';text-align:center;background:' + BRAND_PURPLE + ';' + colorAdjustCss + '">'
    + '<div style="font-size:11px;font-weight:700;letter-spacing:1px;color:' + BRAND_GOLD + ';margin-bottom:4px;">www.arckenites.com</div>'
    + '<div style="font-size:11px;color:' + BRAND_MUTED + ';">We look forward to welcoming you.</div>'
    + '</div>'

    + '</div>'
    + '</body></html>';

  var tPdfBuilt = Date.now();
  var pdf = HtmlService.createHtmlOutput(html).getAs('application/pdf');
  pdf.setName('Arckenites-Ticket-' + ticketId + '.pdf');
  console.log('buildTicketPdf_ timing (ms): qrFetch=' + (tQrDone - tPdfStart)
    + ' htmlToPdf=' + (Date.now() - tPdfBuilt)
    + ' TOTAL=' + (Date.now() - tPdfStart));
  return pdf;
}

/* Requests a Microsoft Graph application-only access token via the OAuth
   client-credentials flow. Credentials are read from Script Properties
   only (Project Settings > Script Properties) — never hardcoded here, and
   never written to any log. Throws (caught by callers, recorded as an
   Email Status/Email Error) if the properties are missing or Microsoft
   rejects the request.

   PERFORMANCE: a fresh token used to be requested on every single send,
   even though Microsoft issues tokens valid for ~1 hour (expires_in).
   That was a full extra network round trip per email for no reason. The
   token is now cached in CacheService (max TTL 6h, so capped at 1h here)
   keyed by tenant+client id, and reused until shortly before it expires. */
function getGraphAccessToken_() {
  var props = PropertiesService.getScriptProperties();
  var tenantId = props.getProperty('GRAPH_TENANT_ID');
  var clientId = props.getProperty('GRAPH_CLIENT_ID');
  var clientSecret = props.getProperty('GRAPH_CLIENT_SECRET');
  if (!tenantId || !clientId || !clientSecret) {
    throw new Error('Microsoft Graph credentials are not configured in Script Properties (GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET).');
  }

  var cache = CacheService.getScriptCache();
  var cacheKey = 'graphToken_' + tenantId + '_' + clientId;
  var cached = cache.get(cacheKey);
  if (cached) {
    console.log('getGraphAccessToken_: cache hit, skipped token request');
    return cached;
  }

  var tTokenStart = Date.now();
  var tokenUrl = 'https://login.microsoftonline.com/' + tenantId + '/oauth2/v2.0/token';
  var response = UrlFetchApp.fetch(tokenUrl, {
    method: 'post',
    payload: {
      client_id: clientId,
      client_secret: clientSecret,
      scope: 'https://graph.microsoft.com/.default',
      grant_type: 'client_credentials',
    },
    muteHttpExceptions: true,
  });
  console.log('getGraphAccessToken_: cache miss, token request took ' + (Date.now() - tTokenStart) + 'ms');

  var body = JSON.parse(response.getContentText());
  if (response.getResponseCode() !== 200 || !body.access_token) {
    throw new Error('Failed to obtain Microsoft Graph access token: ' + (body.error_description || response.getContentText()));
  }

  // Cache for slightly less than the token's real lifetime (safety margin
  // for clock drift / in-flight requests), capped to CacheService's own
  // 6-hour ceiling.
  var ttl = Math.min(Number(body.expires_in || 3600) - 120, 21600);
  if (ttl > 60) {
    cache.put(cacheKey, body.access_token, ttl);
  }
  return body.access_token;
}

/* Sends the ticket email via Microsoft Graph's /sendMail, as
   GRAPH_SENDER_ADDRESS, using application-only (client-credentials) auth.
   Same signature and same throw-on-failure contract as the MailApp
   version it replaces, so doPost and resendFailedTickets need no changes:
   a thrown error here is still caught there and recorded as Email
   Status=Failed with the message in Email Error. */
function sendTicketEmail_(toEmail, name, ticketId, pdfBlob) {
  var subject = 'Your Official Invitation Ticket – Arckenites Inauguration 2026';
  var body = ''
    + 'Dear ' + name + ',\n\n'
    + 'Thank you for registering for the ' + EVENT_NAME + '.\n\n'
    + 'Event: ' + EVENT_NAME + '\n'
    + 'Date: ' + EVENT_DATE_LINE + '\n'
    + 'Time: ' + EVENT_TIME_LINE + '\n'
    + 'Venue: ' + EVENT_VENUE_LINE + '\n\n'
    + 'Your personalised invitation ticket (reference ' + ticketId + ') is attached to this email as a PDF. '
    + 'Please bring it with you, printed or on your phone, to the venue.\n\n'
    + 'We look forward to welcoming you.\n\n'
    + 'Arckenites IT Academy';

  var tTokenStart = Date.now();
  var accessToken = getGraphAccessToken_();
  var tTokenDone = Date.now();

  var message = {
    message: {
      subject: subject,
      body: { contentType: 'Text', content: body },
      toRecipients: [{ emailAddress: { address: toEmail } }],
      attachments: [{
        '@odata.type': '#microsoft.graph.fileAttachment',
        name: 'Arckenites-Ticket-' + ticketId + '.pdf',
        contentType: 'application/pdf',
        contentBytes: Utilities.base64Encode(pdfBlob.getBytes()),
      }],
    },
    saveToSentItems: true,
  };

  var sendUrl = 'https://graph.microsoft.com/v1.0/users/' + encodeURIComponent(GRAPH_SENDER_ADDRESS) + '/sendMail';
  var response = UrlFetchApp.fetch(sendUrl, {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: 'Bearer ' + accessToken },
    payload: JSON.stringify(message),
    muteHttpExceptions: true,
  });

  var code = response.getResponseCode();
  console.log('sendTicketEmail_ timing (ms): getToken=' + (tTokenDone - tTokenStart)
    + ' sendMailPost=' + (Date.now() - tTokenDone)
    + ' TOTAL=' + (Date.now() - tTokenStart));
  if (code !== 202) {
    throw new Error('Microsoft Graph sendMail failed (HTTP ' + code + '): ' + response.getContentText());
  }
}

function escapeHtml_(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function jsonResponse_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/* ---------- Async worker + manual retry (Phase 1 "safe retry",
   now doubling as the PERFORMANCE fix's background worker) ----------
   Not exposed over the web (no doPost/doGet route calls this). Runnable
   manually (Apps Script editor's function picker + Run button) for
   on-demand retries, AND called automatically about once a minute by the
   time-driven trigger registered via createPendingTicketsTrigger_setup()
   (see below) — that trigger is what actually completes a registration's
   PDF+email now that doPost no longer does it synchronously.

   Scans every row that already has a Ticket ID but whose email was never
   successfully delivered — this naturally includes brand-new 'Pending'
   rows a just-submitted registration left behind, not just previously
   'Failed' ones, so no separate "pending queue" data structure is needed.
   Never touches rows that already succeeded, so it's safe to run
   concurrently-in-spirit (guarded below) or be re-run manually at any time.

   Uses a NON-BLOCKING lock: if a previous trigger run is still in
   progress (e.g. a slow PDF/email took longer than the 1-minute trigger
   interval), this run simply skips instead of queueing up, so runs never
   pile up or double-process the same row. */
function resendFailedTickets() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) {
    console.log('resendFailedTickets: another run is already in progress, skipping this invocation');
    return;
  }
  var tRunStart = Date.now();
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Registrations');
    if (!sheet) return;
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return;

    var data = sheet.getRange(2, 1, lastRow - 1, HEADERS.length).getValues();
    var processed = 0;
    for (var i = 0; i < data.length; i++) {
      var row = data[i];
      var name = row[1];
      var email = row[4];
      var ticketId = row[COL_TICKET_ID - 1];
      var emailStatus = row[COL_EMAIL_STATUS - 1];
      var food = row[8]; // 'Preferred Food' column — drives the QR panel's veg/non-veg color
      if (!ticketId || emailStatus === 'Sent') continue; // nothing to do for this row

      var rowIndex = i + 2;
      var tRowStart = Date.now();
      var pdfBlob = null;
      var ticketStatus = 'Failed';
      var newEmailStatus = 'Failed';
      var emailSentAt = '';
      var emailError = '';
      try {
        pdfBlob = buildTicketPdf_(name, ticketId, food);
        ticketStatus = 'Generated';
      } catch (pdfErr) {
        newEmailStatus = 'Skipped';
        emailError = 'Ticket PDF generation failed: ' + String(pdfErr);
      }
      if (pdfBlob) {
        try {
          sendTicketEmail_(email, name, ticketId, pdfBlob);
          newEmailStatus = 'Sent';
          emailSentAt = new Date();
        } catch (mailErr) {
          newEmailStatus = 'Failed';
          emailError = String(mailErr);
        }
      }
      sheet.getRange(rowIndex, COL_TICKET_STATUS, 1, 4).setValues([[ticketStatus, newEmailStatus, emailSentAt, emailError]]);
      console.log('resendFailedTickets: row ' + rowIndex + ' (ticket ' + ticketId + ') took ' + (Date.now() - tRowStart) + 'ms');
      processed++;
      Utilities.sleep(300); // gentle pacing against per-day/per-batch send quotas
    }
    console.log('resendFailedTickets TOTAL: processed ' + processed + ' row(s) in ' + (Date.now() - tRunStart) + 'ms');
  } finally {
    lock.releaseLock();
  }
}

/* ONE-TIME SETUP — run this once from the Apps Script editor (select
   createPendingTicketsTrigger_setup in the function picker, click Run)
   after deploying this version. It registers the time-driven trigger that
   makes registrations actually get their PDF+email: without it, rows will
   be saved as 'Pending' but never progress, since doPost no longer does
   that work itself (see the performance-fix comment on doPost). Safe to
   re-run — it first removes any existing trigger on the same handler, so
   it can never create duplicates that would process rows twice as fast as
   intended. */
function createPendingTicketsTrigger_setup() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'resendFailedTickets') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }
  ScriptApp.newTrigger('resendFailedTickets').timeBased().everyMinutes(1).create();
  console.log('Trigger registered: resendFailedTickets will now run automatically every minute.');
}

/* Builds the mobile-friendly page shown when a ticket's QR code is
   scanned. Deliberately shows only the ticket ID, name and food
   preference — never email, mobile, address, WhatsApp, domain, t-shirt
   size or comments, and never the underlying Sheet row number or any
   other internal identifier. All user-provided values are HTML-escaped.
   Authenticity note: this page has no login of its own (there is nothing
   to log into — this is a public static site with no accounts). The
   ticket ID itself is the credential: it is a 6-character, cryptographically
   random, server-generated value (see generateUniqueTicketId_, ~16.7
   million possible combinations) never derived from or guessable from the
   attendee's name or email, the same model already used elsewhere in this
   project for unguessable tokens (e.g. the VM Lab Agent's bearer token).
   That is a reasonable bar for a lightweight registration-desk check-in
   aid; it is not a replacement for a real authentication system, and this
   function deliberately exposes nothing beyond what the desk already
   needs to see on a scan. */
function buildTicketVerificationHtml_(row) {
  var colorAdjustCss = '-webkit-print-color-adjust:exact;print-color-adjust:exact;color-adjust:exact;';
  var pageShell = function (bodyHtml) {
    return ''
      + '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
      + '<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">'
      + '<title>Arckenites Inauguration — Ticket</title>'
      + '<style>'
      + '*{box-sizing:border-box;}'
      + 'html,body{margin:0;padding:0;width:100%;overflow-x:hidden;background:' + BRAND_PURPLE + ';font-family:Helvetica,Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact;}'
      + '.wrap{max-width:420px;width:100%;margin:0 auto;padding:32px 20px 48px;}'
      + '.card{background:' + BRAND_PURPLE_DARK + ';border:1px solid ' + BRAND_GOLD + ';border-radius:16px;padding:28px 22px;text-align:center;width:100%;max-width:360px;margin:0 auto;}'
      + '.logo{height:44px;width:auto;display:block;margin:0 auto 18px;}'
      + '.row{margin-top:18px;text-align:left;width:100%;}'
      + '.label{font-size:11px;font-weight:700;letter-spacing:2px;color:' + BRAND_MUTED + ';}'
      + '.value{font-size:18px;font-weight:800;color:#ffffff;word-wrap:break-word;overflow-wrap:break-word;word-break:break-word;max-width:300px;margin-top:4px;}'
      + '</style></head>'
      + '<body><div class="wrap"><div class="card">'
      + '<img class="logo" src="data:image/png;base64,' + LOGO_BASE64_PNG + '" alt="Arckenites">'
      + bodyHtml
      + '</div></div></body></html>';
  };

  if (!row) {
    return pageShell(
      '<div style="font-size:20px;font-weight:800;color:' + BRAND_GOLD + ';">Invalid Ticket</div>'
      + '<div style="font-size:13px;color:' + BRAND_MUTED + ';margin-top:10px;max-width:300px;word-wrap:break-word;overflow-wrap:break-word;">'
      + 'This QR code does not match any Arckenites Inauguration ticket on record. '
      + 'Please check with the registration desk.</div>'
    );
  }

  var name = escapeHtml_(String(row[1] || ''));
  var ticketId = escapeHtml_(String(row[COL_TICKET_ID - 1] || ''));
  var rawFood = String(row[8] || '').trim().toLowerCase();
  var foodLabel = rawFood === 'veg' ? 'Veg'
    : (rawFood === 'non-veg' || rawFood === 'nonveg' || rawFood === 'non veg') ? 'Non-Veg'
    : 'Not specified';

  return pageShell(
    '<div style="font-size:11px;font-weight:700;letter-spacing:2px;color:' + BRAND_GOLD + ';">VALID TICKET</div>'
    + '<div class="row"><div class="label">TICKET ID</div><div class="value">' + ticketId + '</div></div>'
    + '<div class="row"><div class="label">NAME</div><div class="value">' + name + '</div></div>'
    + '<div class="row"><div class="label">FOOD PREFERENCE</div><div class="value">' + foodLabel + '</div></div>'
    + '<div class="row"><div class="label">EVENT DATE</div><div class="value">' + escapeHtml_(EVENT_DATE_LINE) + '</div></div>'
    + '<div class="row"><div class="label">EVENT TIME</div><div class="value">' + escapeHtml_(EVENT_TIME_LINE) + '</div></div>'
    + '<div class="row"><div class="label">VENUE</div><div class="value" style="font-size:14px;font-weight:600;">' + escapeHtml_(EVENT_VENUE_LINE) + '</div></div>'
  );
}

/* Two responsibilities, distinguished by the ?ticket= query parameter:
     - ?ticket=ARCK-XXXXXX : the QR-scan verification page a phone opens
       when it scans a ticket's QR code (see buildTicketPdf_). Returns a
       real HTML page via HtmlService, not JSON, since this is what a
       phone's browser renders after scanning.
     - no parameters: the original plain health check, unchanged, so
       opening the bare Web App URL in a browser still confirms it's live
       without needing a real ticket ID. */
function doGet(e) {
  var ticketParam = e && e.parameter && e.parameter.ticket;
  if (ticketParam) {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Registrations');
    var row = sheet ? findRowByTicketId_(sheet, ticketParam) : null;
    return HtmlService.createHtmlOutput(buildTicketVerificationHtml_(row))
      .setTitle('Arckenites Inauguration — Ticket')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1.0, maximum-scale=1.0');
  }
  return jsonResponse_({ status: 'ok', message: 'Inauguration registration endpoint is live.' });
}
