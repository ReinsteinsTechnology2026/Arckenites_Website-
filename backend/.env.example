DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_TTL_MIN=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

ENV=production

# Seed-only, used by seed.py to set the two bootstrap admin passwords on
# first run. Set these to real values before deploying, then never commit
# this file (the real .env is gitignored — this is a template only).
SEED_ADMIN1_USERNAME=akadmin@001
SEED_ADMIN1_PASSWORD=change-me
SEED_ADMIN2_USERNAME=akadmin@002
SEED_ADMIN2_PASSWORD=change-me
