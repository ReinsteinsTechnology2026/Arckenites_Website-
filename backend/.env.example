DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_TTL_MIN=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

ENV=production

# Self-hosted Jitsi Meet deployment backing the Meetings module.
# See backend/MEETINGS_DEPLOYMENT.md for how to stand this up.
MEET_DOMAIN=meet.arckenites.com

# Outbound email — used by the student/staff notification toggle AND the
# Community OTP registration flow. Two transports; Microsoft Graph below is
# used whenever it's fully configured, SMTP here is the fallback only when
# Graph is left blank (e.g. local dev against a personal Gmail account).
# SMTP_USERNAME is the sending Gmail address, SMTP_PASSWORD is a 16-char
# Google App Password (NOT the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Arckenites

# Microsoft Graph — the production email transport when Basic SMTP auth
# isn't usable (e.g. Microsoft Entra Security Defaults enabled, or SMTP AUTH
# disabled for the mailbox). Requires an Entra app registration with the
# Mail.Send Application permission (admin-consented), using the OAuth2
# client-credentials flow — never a user password. All four must be set
# together for Graph to be used; leave all four blank to use SMTP instead.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=admin@arckenites.com

# Seed-only, used by seed.py to set the two bootstrap admin passwords on
# first run. Set these to real values before deploying, then never commit
# this file (the real .env is gitignored — this is a template only).
SEED_ADMIN1_USERNAME=admin1@arckenites.com
SEED_ADMIN1_PASSWORD=change-me
SEED_ADMIN2_USERNAME=admin2@arckenites.com
SEED_ADMIN2_PASSWORD=change-me
