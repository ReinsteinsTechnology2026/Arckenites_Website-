DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_TTL_MIN=60
MFA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

ENV=production

# Self-hosted Jitsi Meet deployment backing the Meetings module.
# See backend/MEETINGS_DEPLOYMENT.md for how to stand this up.
MEET_DOMAIN=meet.arckenites.com

# Self-hosted class recording (trainer-approved). Leave RECORDING_ENABLED=false until the
# LiveKit media server and the staging directory exist; approval is refused (HTTP 503) rather
# than pretending to record. RECORDING_STAGING_DIR must be an absolute path on persistent
# storage OUTSIDE the application checkout, e.g. /srv/arckenites/recordings.
RECORDING_ENABLED=false
RECORDING_STAGING_DIR=
RECORDING_MIN_FREE_GB=20
RECORDING_CONSENT_VERSION=2026-10-v1
TRAINER_RECONNECT_GRACE_SECONDS=60
CLASS_ROOM_OPEN_LEAD_MINUTES=5
CLASS_EXTENSION_MAX_MINUTES=60
JOB_LEASE_SECONDS=120
# Keep false until backend/maintenance/check_onedrive_access.py confirms access and the destination.
ONEDRIVE_UPLOAD_ENABLED=false
# Self-hosted LiveKit (see infra/livekit/README.md). KEY/SECRET are server-side only.
# Independent switches, all OFF by default. Configuring LiveKit does not turn any of them on.
#   LIVEKIT_CLASSROOM_ENABLED: batch classrooms on LiveKit (class routes + "Join class" links). Off = existing Jitsi room.
#   LIVEKIT_MEETINGS_ENABLED:  general meetings on LiveKit (never recorded). Off = existing Jitsi.
#   RECORDING_ENABLED (above): trainer-approved recording inside a LiveKit classroom.
LIVEKIT_CLASSROOM_ENABLED=false
LIVEKIT_MEETINGS_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_OUTPUT_PREFIX=/out

# Outbound email — used by the student/staff notification toggle AND the
# Community OTP registration flow. Two transports; Microsoft Graph below is
# used whenever it's fully configured, SMTP here is the fallback only when
# Graph is left blank (e.g. local dev against a personal Gmail account).
# SMTP_USERNAME is the sending Gmail address, SMTP_PASSWORD is a 16-char
# Google App Password (NOT the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Arckenites

# Microsoft Graph — the production email transport when Basic SMTP auth
# isn't usable (e.g. Microsoft Entra Security Defaults enabled, or SMTP AUTH
# disabled for the mailbox). Requires an Entra app registration with the
# Mail.Send Application permission (admin-consented), using the OAuth2
# client-credentials flow — never a user password. All four must be set
# together for Graph to be used; leave all four blank to use SMTP instead.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=admin@arckenites.com

# Seed-only, used by seed.py to set the two bootstrap admin passwords on
# first run. Set these to real values before deploying, then never commit
# this file (the real .env is gitignored — this is a template only).
SEED_ADMIN1_USERNAME=admin1@arckenites.com
SEED_ADMIN1_PASSWORD=change-me
SEED_ADMIN2_USERNAME=admin2@arckenites.com
SEED_ADMIN2_PASSWORD=change-me

# Private portal files: enabling this does not start class recording.
PORTAL_ONEDRIVE_ENABLED=false
PORTAL_ONEDRIVE_FOLDER_PATH=ArckenitesPortalFiles
ONEDRIVE_DRIVE_ID=
ONEDRIVE_UPLOAD_ENABLED=false
ONEDRIVE_FOLDER_PATH=ArckenitesRecordings
